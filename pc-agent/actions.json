{
  "screenshot": {
    "builtin": "screenshot",
    "needs_confirm": false
  },
  "lock_screen": {
    "argv": ["rundll32.exe", "user32.dll,LockWorkStation"],
    "needs_confirm": false
  },
  "sleep": {
    "builtin": "sleep",
    "needs_confirm": false
  },
  "play_pause": {
    "builtin": "media:play_pause",
    "needs_confirm": false
  },
  "next_track": {
    "builtin": "media:next",
    "needs_confirm": false
  },
  "prev_track": {
    "builtin": "media:prev",
    "needs_confirm": false
  },
  "volume_up": {
    "builtin": "media:volume_up",
    "needs_confirm": false
  },
  "volume_down": {
    "builtin": "media:volume_down",
    "needs_confirm": false
  },
  "mute": {
    "builtin": "media:mute",
    "needs_confirm": false
  },
  "notify": {
    "builtin": "notify",
    "needs_confirm": false
  },
  "shutdown_pc": {
    "argv": ["shutdown.exe", "/s", "/t", "60"],
    "needs_confirm": true
  },
  "restart_pc": {
    "argv": ["shutdown.exe", "/r", "/t", "60"],
    "needs_confirm": true
  },
  "cancel_shutdown": {
    "argv": ["shutdown.exe", "/a"],
    "needs_confirm": false
  },
  "open_url": {
    "needs_confirm": false,
    "variants": {
      "youtube": ["rundll32.exe", "url.dll,FileProtocolHandler", "https://www.youtube.com"],
      "gmail": ["rundll32.exe", "url.dll,FileProtocolHandler", "https://mail.google.com"],
      "calendar": ["rundll32.exe", "url.dll,FileProtocolHandler", "https://calendar.google.com"],
      "github": ["rundll32.exe", "url.dll,FileProtocolHandler", "https://github.com/salvestr0/Jarvis"],
      "jarvis": ["rundll32.exe", "url.dll,FileProtocolHandler", "https://jarvis-theta-umber-27.vercel.app"]
    }
  },
  "open_app": {
    "needs_confirm": false,
    "variants": {
      "chrome": ["C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"],
      "edge": ["C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe"],
      "spotify": ["C:\\Users\\User\\AppData\\Roaming\\Spotify\\Spotify.exe"],
      "discord": [
        "C:\\Users\\User\\AppData\\Local\\Discord\\Update.exe",
        "--processStart",
        "Discord.exe"
      ],
      "telegram": ["C:\\Users\\User\\AppData\\Roaming\\Telegram Desktop\\Telegram.exe"],
      "steam": ["C:\\Program Files (x86)\\Steam\\steam.exe"],
      "notepad": ["notepad.exe"]
    }
  }
}
