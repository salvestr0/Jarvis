# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must NEVER be committed.

# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The browser-safe key. Newer Supabase dashboards call this the "publishable
# key" (starts with sb_publishable_); older ones call it the "anon key" (a long
# JWT). Either works — set whichever your dashboard shows.
#
# Safe in the browser ONLY because Row Level Security is enabled on every
# table. The key by itself grants an attacker nothing.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# DANGER ZONE
# ---------------------------------------------------------------------------
# The service role key IGNORES Row Level Security. Anyone holding it can read
# and write your entire database.
#
# Rules, no exceptions:
#   - never prefix it with NEXT_PUBLIC_ (that ships it to the browser)
#   - never import it into a Client Component
#   - only used by the scheduled price job (server-side)
#
# Only the scheduled price job (/api/cron/prices) uses this, because a cron
# has no user session to authenticate as. Nothing else in the app touches it.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret protecting /api/cron/prices. Vercel automatically sends this
# as an Authorization: Bearer header on scheduled runs once it's set in the
# project's environment variables.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------
# Stock/ETF prices via Finnhub. Free tier: 60 requests/min.
# Sign up at https://finnhub.io/register
#
# No NEXT_PUBLIC_ prefix — this key is only ever used server-side. Putting it
# in browser code would let anyone read it from the page source and burn
# through your rate limit.
#
# Crypto prices (CoinGecko) and FX rates (Frankfurter) need no key at all.
FINNHUB_API_KEY=

# ---------------------------------------------------------------------------
# Migrations only
# ---------------------------------------------------------------------------
# Full Postgres connection string, used ONLY by `npm run db:migrate` to create
# tables. The running app never reads this. It contains your database password,
# so it lives here in a gitignored file — never in a commit or a chat message.
#
# Supabase -> Project Settings -> Database -> Connection string -> URI
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# The single email allowed to use this app. If blank, nobody can log in
# (fails closed on purpose). The Telegram bot also uses this to resolve which
# auth user it acts for.
ALLOWED_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Jarvis Telegram bot (Phase 2)
# ---------------------------------------------------------------------------
# Claude API key from console.anthropic.com. Server-side only — never
# NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Bot token from @BotFather on Telegram. Server-side only — never
# NEXT_PUBLIC_. Anyone holding it IS your bot.
TELEGRAM_BOT_TOKEN=

# Shared secret registered at setWebhook time (npm run telegram:setup).
# Telegram echoes it back on every webhook call; the route rejects anything
# else, and refuses to run at all if this is blank.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# Your numeric Telegram user id (message @userinfobot to see it). Messages
# from any other account are silently dropped. Not a secret, but required —
# blank means the bot refuses to run (fails closed on purpose).
TELEGRAM_USER_ID=

# Selects the request-scoped Hermes service after it has been deployed and
# verified. Use `legacy` for rollback; unknown values fail closed.
JARVIS_AGENT_BACKEND=legacy

# Main Next.js project -> Python agent service. Both values are server-only.
# Generate the shared secret with the same command used for CRON_SECRET, then
# set the identical value on both Vercel projects.
AGENT_SERVICE_URL=https://your-agent-project.vercel.app
AGENT_SERVICE_SECRET=

# Exact sender addresses permitted for receipt previews, comma-separated.
# Domains and arbitrary Gmail search queries are deliberately not accepted.
FINANCE_EMAIL_SENDERS=alerts@your-bank.example

# Python agent project only. JARVIS_CAPABILITY_URL is the main app's origin.
JARVIS_CAPABILITY_URL=https://your-main-project.vercel.app
DEEPSEEK_API_KEY=
AGENT_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# Google — read-only Calendar + Gmail (Phase 3)
# ---------------------------------------------------------------------------
# Desktop-app OAuth client from console.cloud.google.com (see DEPLOY.md for
# the full checklist, including publishing the consent screen to production —
# in Testing mode refresh tokens die after 7 days).
#
# All three are server-only. The client secret and refresh token are real
# secrets: together they grant read access to your calendar and email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Minted once with:  npm run google:auth
GOOGLE_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Voice notes
# ---------------------------------------------------------------------------
# Transcribes Telegram voice messages (Whisper on Groq — free tier, no card).
# Claude's API doesn't take audio, hence a second provider for this one job.
# Get a key at console.groq.com. Server-only — never NEXT_PUBLIC_.
#
# Leave blank to disable voice: text messages keep working, and a voice note
# gets a plain "something went wrong" reply.
GROQ_API_KEY=
